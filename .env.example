# Postgres / pgvector (langchain-postgres uses the psycopg driver)
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# Elasticsearch hybrid (BM25 + dense kNN)
ELASTICSEARCH_URL=http://localhost:9200

# Embeddings, rerank, generation
VOYAGE_API_KEY=
COHERE_API_KEY=
OPENAI_API_KEY=

# Optional Braintrust tracing (call ragkit.setup_braintrust() yourself)
# BRAINTRUST_API_KEY=
# BRAINTRUST_PROJECT=ragkit
# BRAINTRUST_PROJECT_ID=
